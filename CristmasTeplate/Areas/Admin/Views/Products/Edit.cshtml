@model ProductEditVM

<div class="card-style mb-30" style="width: 30%; margin: 0 auto; margin-top: 13%;">
    <form asp-action="edit" method="post">
        <h6 class="mb-25">Create Product</h6>

        <div class="input-style-1">
            <label>Title</label>
            <input asp-for="Name" type="text" placeholder="Product Title" />
        </div>

        <div class="input-style-1">
            <label>Description</label>
            <input asp-for="Description" type="text" placeholder="Product Description" />
        </div>

        <div class="input-style-1">
            <label>Price</label>
            <input asp-for="Price" type="text" placeholder="Product Price" />
        </div>

        <div class="input-style-1">
            <label>Style</label>
            <input asp-for="Style" type="text" placeholder="Product Style" />
        </div>

        <div class="select-style-1">
            <label>Category</label>
            <div class="select-position">
                <select asp-for="CategoryId" asp-items="Model.Categories"></select>
            </div>
        </div>

        <div class="input-style-1">
            <label>Composition</label>
            <input asp-for="Composition" type="text" placeholder="Product Composition" />
        </div>

        <div class="input-style-1">
            <label>Image</label>
            <input asp-for="Image" type="file" placeholder="Product Composition" />
        </div>

        <button class="btn btn-group" type="submit">Edit</button>
        <a class="btn btn-danger" asp-action="index">Back</a>
    </form>
</div>