@model IEnumerable<CategoryVM>

<div style="text-align: center; margin-top: 15pc;     display: flex;
    justify-content: center;
    flex-direction: column;
    gap: 6pc;">
    <h1>Products</h1>
    <a asp-action="create" class="btn btn-success" style="    width: 15%;
    margin: 0 auto;">Create</a>
    <table class="table" style="    width: 80%;
        margin-left: 19pc;
        padding-left: 13pc;">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Operations</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td style="    display: flex;
                        justify-content: center;
                        gap: 2pc;">
                        <a class="btn btn-secondary" asp-action="edit" asp-route-id="@item.Id">Edit</a>
                        <form>
                            <button class="btn btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

