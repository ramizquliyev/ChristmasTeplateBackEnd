@model LoginVM

<style>
    .auth-main {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 75vh;
        padding: 40px 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .auth-card {
        background: #ffffff;
        width: 100%;
        max-width: 380px;
        padding: 35px;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        border: 1px solid #eaeaea;
    }

    .auth-title {
        text-align: center;
        margin-top: 0;
        margin-bottom: 25px;
        font-size: 26px;
        font-weight: 600;
        color: #222;
    }

    .auth-group {
        margin-bottom: 18px;
    }

    .auth-label {
        display: block;
        margin-bottom: 6px;
        font-size: 14px;
        font-weight: 500;
        color: #444;
    }

    .auth-input {
        width: 100%;
        padding: 11px 14px;
        font-size: 15px;
        border: 1px solid #ccc;
        border-radius: 8px;
        box-sizing: border-box;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .auth-input:focus {
            outline: none;
            border-color: #c0392b;
            box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.12);
        }

    .auth-btn {
        width: 100%;
        padding: 12px;
        margin-top: 10px;
        background-color: #c0392b;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .auth-btn:hover {
            background-color: #a93226;
        }

    .auth-footer {
        text-align: center;
        margin-top: 20px;
        font-size: 14px;
        color: #666;
    }

        .auth-footer a {
            color: #c0392b;
            text-decoration: none;
            font-weight: 600;
        }

            .auth-footer a:hover {
                text-decoration: underline;
            }
</style>

<main class="auth-main">
    <div class="auth-card">
        <h2 class="auth-title">Login</h2>
        <div class="text-danger" asp-validation-summary="All">

        </div>
        <form asp-action="login" method="post">
            <div class="auth-group">
                <label class="auth-label">Username</label>
                <input type="text" asp-for="UserName" class="auth-input" placeholder="Enter username" />
            </div>

            <div class="auth-group">
                <label class="auth-label">Password</label>
                <input type="password" asp-for="Password" class="auth-input" placeholder="Enter password" />
            </div>

            <button type="submit" class="auth-btn">Login</button>
        </form>

        <div class="auth-footer">
            Don't have an account? <a asp-action="register">Register</a>
        </div>
    </div>
</main>