@model IEnumerable<BasketUIVM>

@await Component.InvokeAsync("BasketBanner");

<div class="wishlist-section section pt-120 pb-90">
    <div class="container">
        <div class="row">
            <div class="col-12">
                   
                <div class="table-responsive mb-30">
                    <table class="table cart-table text-center">
                            
                        <!-- Table Head -->
                        <thead>
                            <tr>
                                <th class="image">Image</th>
                                <th class="name">Product Name</th>
                                <th class="price">Category</th>
                                <th class="price">Description</th>
                                <th class="price">Price</th>
                                <th class="remove">remove</th>
                            </tr>
                        </thead>
                            
                        <!-- Table Body -->
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><a class="cart-pro-image"><img src="~/img/product/@item.MainImg" alt="Img"/></a></td>
                                    <td><a class="cart-pro-title" asp-controller="productdetail" asp-action="detail" asp-route-id="@item.ProductId">@item.Name</a></td>
                                    <td><a href="#" class="cart-pro-title">@item.Category</a></td>
                                    <td><a href="#" class="cart-pro-title">@item.Description</a></td>
                                    <td><p class="cart-pro-price">$@item.Price</p></td>
                                    <td>
                                        <form method="post" asp-controller="basket" asp-action="delete" asp-route-id="@item.Id">
                                            <button type="submit" class="cart-pro-remove"><i class="fa fa-trash-o"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            
                        </tbody>
                    </table>
                </div>
                    
            </div>
        </div>
    </div>
</div><!-- Wishlist Section End-->
